# ==============================================================================
# FMS MCU - Docker Production Environment Configuration (.env)
# ==============================================================================

# พอร์ตที่เปิดบนเครื่องโฮสต์ (ค่าเริ่มต้น 3010 หรือเปลี่ยนเป็น 80 เพื่อเข้าผ่าน http://localhost)
HOST_PORT=3010

# การตั้งค่าฐานข้อมูล PostgreSQL ใน Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fms_mcu_secure_db_pass_2026
POSTGRES_DB=ums_prod

# คีย์ลับสำหรับ NextAuth JWE Encryption (สุ่ม 32 bytes เช่น openssl rand -base64 32)
AUTH_SECRET=fms_mcu_vipassana_production_secret_32bytes_min
AUTH_TRUST_HOST=true

# URL ภายนอกของระบบ
APP_URL=http://localhost:3010

# กำหนดให้รัน Initial Seed อัตโนมัติในครั้งแรกที่สร้างฐานข้อมูล (1 = เปิดใช้งาน, 0 = ปิด)
SEED_ON_BOOT=1

# บัญชี Super Admin ตั้งต้น (เมื่อรัน seed):
# Email:    admin@app.local
# Password: Passw0rd!vibe

# Google OAuth 2.0 Credentials (สร้างจาก https://console.cloud.google.com/apis/credentials)
# ระบุ Authorized redirect URIs:
# 1. http://localhost:3010/api/auth/callback/google
# 2. https://cas-meters-ensemble-emperor.trycloudflare.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_AUTO_PROVISION=false

